<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Heart rate: BODY_SENSORS up to Wear OS 5 (API 35); Wear OS 6 (API 36)
         replaced it with the granular health permission. Asked at Start. -->
    <uses-permission android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- Keeps the heart-rate exercise alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Needs the Felt Notes phone app: heart rate goes watch -> own
             phone over Bluetooth only (docs/PULSE.md). -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PulseService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Start/stop from the phone (path /feltnotes/pulse/v1/ctl). -->
        <service
            android:name=".PulseListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/feltnotes/pulse/v1/ctl"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
