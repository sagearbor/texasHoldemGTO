<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store export, signed automatically via the App Store Connect API
	     key (xcodebuild -exportArchive -allowProvisioningUpdates
	     -authenticationKey*). flutter build ipa can't forward those flags.
	     See scripts/ios-release.sh. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>553Y9KWR84</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
